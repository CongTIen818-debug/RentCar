@model VehicleListViewModel
@using System.Globalization
        <div class="showroom-grid">
            @foreach (var car in Model.Cars)
            {
                var seats = car.Seats;
                <article class="showroom-car">
                    <a class="showroom-image-link" asp-controller="Cars" asp-action="Details" asp-route-id="@car.Id"
                       asp-route-pickupAt="@Model.PickupAt?.ToString("s")" asp-route-returnAt="@Model.ReturnAt?.ToString("s")" asp-route-withDriver="@Model.WithDriver">
                        @if (!string.IsNullOrWhiteSpace(car.ImageUrl))
                        {
                            <img src="@car.ImageUrl" alt="@car.Name" loading="lazy" width="768" height="512" />
                        }
                        else
                        {
                            <span class="rental-car-placeholder">Chưa có ảnh xe</span>
                        }
                    </a>
                    <div class="showroom-car-body">
                        <h3><a asp-controller="Cars" asp-action="Details" asp-route-id="@car.Id"
                               asp-route-pickupAt="@Model.PickupAt?.ToString("s")" asp-route-returnAt="@Model.ReturnAt?.ToString("s")" asp-route-withDriver="@Model.WithDriver">@car.Name</a></h3>
                        <ul class="showroom-specs" aria-label="Thông số xe">
                            <li><svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><circle cx="12" cy="7" r="3" /><path d="M5 21v-3a7 7 0 0 1 14 0v3M8 21v-4m8 4v-4" /></svg><span>@(seats <= 0 ? car.VehicleType : $"{seats} chỗ")</span></li>
                            @if (!string.IsNullOrWhiteSpace(car.Transmission))
                            {
                                <li><svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><circle cx="6" cy="4" r="2"/><circle cx="18" cy="4" r="2"/><circle cx="6" cy="20" r="2"/><path d="M6 6v12M18 6v6H6M12 4v16"/></svg><span>@car.Transmission</span></li>
                            }
                            @if (!string.IsNullOrWhiteSpace(car.Fuel))
                            {
                                <li><svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M4 21V4h10v17M2 21h14M6 7h6v5H6zM14 11h3v6a2 2 0 0 0 4 0V8l-3-3"/></svg><span>@car.Fuel</span></li>
                            }
                        </ul>
                        <div class="showroom-car-footer">
                            <div class="showroom-rate">
                                @if (car.DailyRate < car.OriginalRate)
                                {
                                    <del class="showroom-old-price">@car.OriginalRate.ToString("N0", CultureInfo.GetCultureInfo("vi-VN")) ₫</del>
                                }
                                <p class="showroom-price">@car.DailyRate.ToString("N0", CultureInfo.GetCultureInfo("vi-VN")) ₫ <span>/ ngày</span></p>
                            </div>
                            <a class="showroom-details" asp-controller="Cars" asp-action="Details" asp-route-id="@car.Id"
                               asp-route-pickupAt="@Model.PickupAt?.ToString("s")" asp-route-returnAt="@Model.ReturnAt?.ToString("s")" asp-route-withDriver="@Model.WithDriver" aria-label="Xem chi tiết @car.Name">Chi tiết <span aria-hidden="true">→</span></a>
                        </div>
                    </div>
                </article>
            }
        </div>
