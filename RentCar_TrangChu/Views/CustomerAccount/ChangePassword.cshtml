@model RentCar.Web.Models.ChangePasswordForm
@{ ViewData["Title"]="Đổi mật khẩu"; }
@{ ViewData["BodyClass"]="rentcar-contracts"; }
<section class="customer-account-page">
<nav class="account-tabs"><a asp-action="Profile">Hồ sơ &amp; GPLX</a><a asp-action="ChangePassword">Đổi mật khẩu</a><a asp-action="Privacy">Quyền riêng tư</a></nav>
<h1>Đổi mật khẩu</h1><p class="account-intro">Sau khi đổi mật khẩu, bạn sẽ đăng nhập lại. Mật khẩu cần ít nhất 8 ký tự, có chữ hoa, chữ thường và số.</p><form method="post" asp-action="ChangePassword" class="customer-account-form"><div asp-validation-summary="All" class="text-danger" role="alert"></div>
<label asp-for="CurrentPassword">Mật khẩu hiện tại</label><input asp-for="CurrentPassword" type="password" autocomplete="current-password" maxlength="128" /><span asp-validation-for="CurrentPassword"></span>
<label asp-for="NewPassword">Mật khẩu mới</label><input asp-for="NewPassword" type="password" autocomplete="new-password" minlength="8" maxlength="128" pattern="(?=.*\p{Lu})(?=.*\p{Ll})(?=.*\p{Nd}).{8,}" title="Mật khẩu tối thiểu 8 ký tự, có chữ hoa, chữ thường và số." /><span asp-validation-for="NewPassword"></span>
<label asp-for="ConfirmPassword">Nhập lại mật khẩu mới</label><input asp-for="ConfirmPassword" type="password" autocomplete="new-password" maxlength="128" /><span asp-validation-for="ConfirmPassword"></span>
<button type="submit" class="btn management-primary">Đổi mật khẩu</button></form></section>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
