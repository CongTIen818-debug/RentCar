@model RentCar.Web.Models.ForgotPasswordForm
@{ ViewData["Title"]="Quên mật khẩu"; ViewData["BodyClass"]="rentcar-contracts"; }
<section class="customer-account-page"><p class="requests-eyebrow">RENTCAR · KHÔI PHỤC TÀI KHOẢN</p><h1>Quên mật khẩu</h1>
@if(ViewData["Requested"] is true) { <div class="account-success" role="status">Nếu email đã đăng ký, liên kết khôi phục sẽ được gửi. Liên kết có hiệu lực 30 phút và chỉ dùng một lần.</div> }
@if(ViewData["ResetPreview"] is string preview) { <p class="contract-note">Liên kết kiểm thử trong môi trường phát triển:</p><a href="@preview">Mở trang đặt lại mật khẩu</a> }
<form asp-action="ForgotPassword" method="post" class="customer-account-form"><div asp-validation-summary="All" class="text-danger" role="alert"></div><label asp-for="Email">Email đã đăng ký</label><input asp-for="Email" type="email" maxlength="100" autocomplete="email" /><span asp-validation-for="Email"></span><button type="submit" class="btn management-primary">Gửi liên kết khôi phục</button></form><a asp-controller="Account" asp-action="Login" class="request-back">← Đăng nhập</a></section>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
