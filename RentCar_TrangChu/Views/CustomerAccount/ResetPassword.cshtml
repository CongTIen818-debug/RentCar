@model RentCar.Web.Models.ResetPasswordForm
@{ ViewData["Title"]="Đặt lại mật khẩu"; ViewData["BodyClass"]="rentcar-contracts"; }
<section class="customer-account-page"><h1>Đặt lại mật khẩu</h1><p class="account-intro">Liên kết chỉ có hiệu lực 30 phút và không dùng lại sau khi hoàn tất.</p><form method="post" asp-action="ResetPassword" class="customer-account-form"><div asp-validation-summary="All" class="text-danger" role="alert"></div>
<input asp-for="Email" type="hidden" /><input asp-for="Code" type="hidden" />
<label asp-for="NewPassword">Mật khẩu mới</label><input asp-for="NewPassword" type="password" autocomplete="new-password" minlength="8" maxlength="128" pattern="(?=.*\p{Lu})(?=.*\p{Ll})(?=.*\p{Nd}).{8,}" title="Mật khẩu tối thiểu 8 ký tự, có chữ hoa, chữ thường và số." /><span asp-validation-for="NewPassword"></span>
<label asp-for="ConfirmPassword">Nhập lại mật khẩu mới</label><input asp-for="ConfirmPassword" type="password" autocomplete="new-password" maxlength="128" /><span asp-validation-for="ConfirmPassword"></span>
<button type="submit" class="btn management-primary">Lưu mật khẩu mới</button></form><a asp-action="ForgotPassword" class="request-back">Yêu cầu liên kết mới</a></section>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
