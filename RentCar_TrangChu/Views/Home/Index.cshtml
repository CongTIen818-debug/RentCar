@using System.Globalization
@model VehicleFilterViewModel
@inject RentCar.Services.VehicleCatalog Catalog
@{
    ViewData["Title"] = "Trang chủ";
    ViewData["BodyClass"] = "rentcar-home-light";
}

<section class="rental-services" aria-label="Dịch vụ thuê xe">
    <a class="rental-service rental-service-main" href="/dich-vu/thue-xe-tu-lai">
        <img src="~/images/services/self-drive.png" asp-append-version="true" alt="Bộ sưu tập siêu xe cho thuê tự lái" fetchpriority="high" />
        <h2>Thuê xe tự lái</h2>
    </a>
    <a class="rental-service" href="/dich-vu/thue-xe-kem-tai-xe">
        <img src="~/images/services/chauffeur.jpg" asp-append-version="true" alt="Nội thất xe sang cho dịch vụ thuê kèm tài xế" />
        <h2>Thuê kèm tài xế</h2>
    </a>
    <a class="rental-service rental-service-event" href="/dich-vu/thue-xe-su-kien">
        <img src="~/images/services/event-rental.png" asp-append-version="true" alt="Người mẫu bên chiếc Rolls-Royce vàng tại showroom" />
        <h2>Thuê xe sự kiện</h2>
    </a>
</section>
<section class="rental-hero">
    <div class="rental-intro">
        <p>RENTCAR · THUÊ XE TỰ LÁI</p>
        <h1>Tìm xe cho chuyến đi của bạn</h1>
        <p>Khám phá xe sang cho chuyến đi của bạn.</p>
    </div>
    <form id="rental-search" class="rental-search" method="get" asp-controller="Home" asp-action="Index">
        <div class="rental-location">
            <label for="locationId">Điểm giao nhận</label>
            <select id="locationId" name="locationId" required aria-describedby="location-help location-address" disabled="@(Model is null || Model.Locations.Count == 0)">
                <option value="">Chọn điểm nhận và trả xe tại Hà Nội</option>
                @if (Model is not null)
                {
                    @foreach (var location in Model.Locations)
                    {
                        <option value="@location.Id" selected="@(Model.LocationId == location.Id)" data-address="@location.Address">@location.Name — @location.Address</option>
                    }
                }
            </select>
            <p id="location-help">Nhận và trả xe tại cùng một địa điểm.</p>
            <p id="location-address" aria-live="polite">@Model?.Locations.FirstOrDefault(location => location.Id == Model.LocationId)?.Address</p>
        </div>
        <partial name="_RentalDates" model="@(new RentalDates(Model?.PickupAt, Model?.ReturnAt))" />
        @if (Model is null) { <p role="alert">Chưa tải được dữ liệu xe. Vui lòng thử lại sau.</p> }
        @if (Model?.SearchError is string error)
        {
            <p role="alert">@error</p>
        }
        <label for="car-sort">Sắp xếp đội xe</label>
        <select id="car-sort" name="sort">
            @foreach (var option in new[] { ("default","Mặc định"),("price-asc","Giá tăng dần"),("price-desc","Giá giảm dần"),("name","Tên xe A–Z"),("seats","Số chỗ tăng dần") })
            { <option value="@option.Item1" selected="@(Model?.Search.Sort == option.Item1)">@option.Item2</option> }
        </select>
        <button type="submit" disabled="@(Model is null)">Tìm xe</button>
    </form>
</section>

@if (Model is { SearchError: null })
{
    <section class="showroom-catalog" aria-labelledby="showroom-title">
        <div class="showroom-heading">
            <p>BỘ SƯU TẬP RENTCAR</p>
            <h2 id="showroom-title">@(Model.IsSearch ? "Kết quả tìm xe" : "Cho thuê xe sang & siêu xe")</h2>
            <span>@Model.ResultCount xe phù hợp</span>
        </div>
        @if (Model.ResultCount == 0)
        {
            <p role="status">Chưa có xe phù hợp. Bạn hãy thử lịch thuê hoặc bộ lọc khác.</p>
        }
        <partial name="_VehicleGrid" model="@(new VehicleListViewModel(Model.Results, Model.PickupAt, Model.ReturnAt))" />
        @if (Model.Pages > 1)
        {
            string PageUrl(int page) {
                var values=Context.Request.Query.ToDictionary(p=>p.Key,p=>p.Value);
                values["page"]=page.ToString();
                return Microsoft.AspNetCore.WebUtilities.QueryHelpers.AddQueryString(Url.Action("Index","Home")!,values);
            }
            <nav class="requests-pagination" aria-label="Phân trang xe">
                @if(Model.Page>1) { <a href="@PageUrl(Model.Page-1)">← Trang trước</a> }
                <span>Trang @Model.Page / @Model.Pages · @Model.ResultCount xe</span>
                @if(Model.Page<Model.Pages) { <a href="@PageUrl(Model.Page+1)">Trang sau →</a> }
            </nav>
        }
        <p class="showroom-source">Hình ảnh và giá tham khảo từ <a href="https://richcars.vn/vi/richcars-dich-vu-thue-xe-sang-uy-tin-lau-doi/" target="_blank" rel="noopener noreferrer">RichCars</a>.</p>
    </section>
}

@section Sidebar {
    <div class="vehicle-filters">
        <h2>Lọc xe</h2>
        @if (Model is null)
        {
            <p role="status">Chưa tải được bộ lọc từ cơ sở dữ liệu.</p>
        }
        else
        {
            <div>
                <details class="filter-group" open="@(Model.SelectedBrands.Length > 0)">
                    <summary>Hãng xe @if (Model.SelectedBrands.Length > 0) { <span class="filter-selected-count">@Model.SelectedBrands.Length</span> }</summary>
                    <fieldset>
                        <legend class="visually-hidden">Hãng xe</legend>
                        @foreach (var option in Model.Brands)
                        {
                            <label class="vehicle-filter-option">
                                <input form="rental-search" type="checkbox" name="brands" value="@option.Value"
                                       checked="@Model.SelectedBrands.Contains(option.Value, StringComparer.OrdinalIgnoreCase)" />
                                <span>@option.Value</span><small>@option.Count</small>
                            </label>
                        }
                    </fieldset>
                </details>
                <details class="filter-group" open="@(Model.SelectedTypes.Length > 0)">
                    <summary>Loại xe @if (Model.SelectedTypes.Length > 0) { <span class="filter-selected-count">@Model.SelectedTypes.Length</span> }</summary>
                    <fieldset>
                        <legend class="visually-hidden">Loại xe</legend>
                        @foreach (var option in Model.Types)
                        {
                            <label class="vehicle-filter-option">
                                <input form="rental-search" type="checkbox" name="types" value="@option.Value" checked="@Model.SelectedTypes.Contains(option.Value)" />
                                <span>@option.Value</span><small>@option.Count</small>
                            </label>
                        }
                    </fieldset>
                </details>
                <details class="filter-group" open="@(Model.SelectedSeats.Length > 0)">
                    <summary>Số chỗ @if (Model.SelectedSeats.Length > 0) { <span class="filter-selected-count">@Model.SelectedSeats.Length</span> }</summary>
                    <fieldset>
                        <legend class="visually-hidden">Số chỗ</legend>
                        @foreach (var option in Model.Seats)
                        {
                            <label class="vehicle-filter-option">
                                <input form="rental-search" type="checkbox" name="seats" value="@option.Value" checked="@Model.SelectedSeats.Contains(option.Value)" />
                                <span>@option.Value chỗ</span><small>@option.Count</small>
                            </label>
                        }
                    </fieldset>
                </details>

                <details class="filter-group" open="@(Model.Search.Transmissions.Length>0)"><summary>Hộp số</summary><fieldset><legend class="visually-hidden">Hộp số</legend>
                    @foreach(var option in Model.Transmissions) { <label class="vehicle-filter-option"><input form="rental-search" type="checkbox" name="transmissions" value="@option.Value" checked="@Model.Search.Transmissions.Contains(option.Value)" /><span>@option.Value</span><small>@option.Count</small></label> }
                </fieldset></details>
                <details class="filter-group" open="@(Model.Search.Fuels.Length>0)"><summary>Nhiên liệu</summary><fieldset><legend class="visually-hidden">Nhiên liệu</legend>
                    @foreach(var option in Model.Fuels) { <label class="vehicle-filter-option"><input form="rental-search" type="checkbox" name="fuels" value="@option.Value" checked="@Model.Search.Fuels.Contains(option.Value)" /><span>@option.Value</span><small>@option.Count</small></label> }
                </fieldset></details>
                <fieldset><legend>Giá thuê từ</legend><input form="rental-search" name="minPrice" type="number" min="0" max="1000000000" step="1000" value="@Model.Search.MinPrice" placeholder="0 ₫ / ngày" aria-label="Giá thuê tối thiểu mỗi ngày" class="filter-min-price" /></fieldset>
                <fieldset>
                    <legend>Giá thuê tối đa mỗi ngày</legend>
                    <input form="rental-search" id="max-price" aria-label="Giá thuê tối đa mỗi ngày" type="range" name="maxPrice"
                           min="0" max="@Model.HighestPrice.ToString(CultureInfo.InvariantCulture)" step="0.01"
                           value="@Model.SelectedPrice.ToString(CultureInfo.InvariantCulture)" />
                    <output id="price-label" for="max-price">@Model.SelectedPrice.ToString("N0", CultureInfo.GetCultureInfo("vi-VN")) ₫</output>
                </fieldset>
                <button form="rental-search" type="submit" formnovalidate>Áp dụng</button>
                <a asp-controller="Home" asp-action="Index">Xóa lọc</a>
                <p class="vehicle-filter-count" role="status">@Model.ResultCount xe phù hợp</p>
            </div>
        }
    </div>
}

@section Scripts {
    <script>
        const locationSelect = document.getElementById('locationId');
        if (locationSelect) {
            locationSelect.addEventListener('change', () => {
                document.getElementById('location-address').textContent = locationSelect.selectedOptions[0]?.dataset.address || '';
            });
        }
        const priceSlider = document.getElementById('max-price');
        if (priceSlider) {
            const priceLabel = document.getElementById('price-label');
            const formatPrice = new Intl.NumberFormat('vi-VN', { style: 'currency', currency: 'VND' });
            priceSlider.addEventListener('input', () => {
                priceLabel.value = formatPrice.format(priceSlider.valueAsNumber);
            });
        }
    </script>
}
