@model EmployeesForm
@{
    Layout = "_ManagementLayout";
    ViewData["Title"] = ViewContext.RouteData.Values["id"] is null ? "Thêm mới · Nhân viên" : "Chỉnh sửa · Nhân viên";
}
<form method="post" asp-action="Edit" asp-route-id="@ViewContext.RouteData.Values["id"]" class="row g-3">
    <div asp-validation-summary="All" class="text-danger"></div>
    <div class="col-md-6">
        <label asp-for="FullName" class="form-label"></label>
        <input asp-for="FullName" class="form-control" />
    </div>
    <div class="col-md-6">
        <label asp-for="Email" class="form-label"></label>
        <input asp-for="Email" class="form-control" />
    </div>
    <div class="col-md-6">
        <label asp-for="Role" class="form-label"></label>
        <select asp-for="Role" class="form-select">
            <option value="">Chọn vai trò</option>
            <option>Nhân viên kinh doanh</option>
            <option>Nhân viên giao nhận</option>
            <option>Kế toán</option>
            <option>Quản trị viên</option>
        </select>
    </div>
    <div>
        <button type="submit" class="btn management-primary">Lưu</button>
        <a asp-action="Index" class="btn btn-outline-secondary">Quay lại</a>
    </div>
</form>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
