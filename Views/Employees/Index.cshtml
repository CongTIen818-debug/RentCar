@model IReadOnlyList<RentCar.Models.Database.AppUser>
@{
    Layout = "_ManagementLayout";
    ViewData["Title"] = "Nhân viên";
}
<a asp-action="Edit" class="btn management-primary mb-3">Thêm mới</a>
<div class="table-responsive">
    <table class="table align-middle">
        <thead><tr><th scope="col">Họ tên</th><th scope="col">Email</th><th scope="col">Vai trò</th><th scope="col">Hoạt động</th><th scope="col">Thao tác</th></tr></thead>
        <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.FullName</td>
                <td>@item.Email</td>
                <td>@item.Role</td>
                <td>@(item.IsActive ? "Hoạt động" : "Vô hiệu hóa")</td>
                <td>
                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary">Sửa</a>
                    @if (item.IsActive)
                    {
                        <form asp-action="Delete" asp-route-id="@item.Id" method="post" class="d-inline" onsubmit="return confirm('Vô hiệu hóa tài khoản này?');">
                            <button type="submit" class="btn btn-sm btn-outline-danger">Vô hiệu hóa</button>
                        </form>
                    }
                </td>
            </tr>
        }
        </tbody>
    </table>
</div>
