@model RegisterForm
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Đăng ký · RentCar</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/rentcar-layout.css" asp-append-version="true" />
</head>
<body class="rentcar-login">
    <main class="rentcar-login-card rentcar-register-card">
        <a class="rentcar-brand" asp-controller="Home" asp-action="Index">
            <span class="rentcar-brand-mark" aria-hidden="true">R</span>
            <span>Rent<span class="rentcar-accent">Car</span><small>Thuê xe tự lái</small></span>
        </a>
        <h1 class="h3 mt-4">Tạo tài khoản RentCar</h1>
        <p class="auth-intro">Đăng ký để bắt đầu hành trình của bạn.</p>
        <form asp-controller="Account" asp-action="Register" method="post" class="d-grid gap-3 mt-4">
            <input asp-for="ReturnUrl" type="hidden" />
            <div asp-validation-summary="All" class="text-danger auth-validation" role="alert"></div>
            <div>
                <label asp-for="FullName" class="form-label">Họ và tên</label>
                <input asp-for="FullName" autocomplete="name" class="form-control" placeholder="Nhập họ và tên" minlength="2" maxlength="100" required />
            </div>
            <div>
                <label asp-for="Email" class="form-label">Email</label>
                <input asp-for="Email" type="email" autocomplete="email" class="form-control" placeholder="Nhập email của bạn" maxlength="100" required />
            </div>
            <div>
                <label asp-for="Phone" class="form-label">Số điện thoại</label>
                <input asp-for="Phone" type="tel" autocomplete="tel" class="form-control" placeholder="Nhập số điện thoại" maxlength="20" />
            </div>
            <div>
                <label asp-for="Password" class="form-label">Mật khẩu</label>
                <div class="input-group">
                    <input asp-for="Password" type="password" value="" autocomplete="new-password" class="form-control" placeholder="Ít nhất 6 ký tự" minlength="6" maxlength="256" aria-describedby="password-help" required />
                    <button type="button" id="register-toggle-password" class="btn btn-outline-secondary" aria-controls="Password ConfirmPassword" aria-pressed="false" hidden>Hiện</button>
                </div>
                <small id="password-help" class="auth-optional">Sử dụng từ 6 đến 256 ký tự.</small>
            </div>
            <div>
                <label asp-for="ConfirmPassword" class="form-label">Nhập lại mật khẩu</label>
                <input asp-for="ConfirmPassword" type="password" value="" autocomplete="new-password" class="form-control" placeholder="Nhập lại mật khẩu" minlength="6" maxlength="256" required />
            </div>
            <button type="submit" class="btn management-primary">Đăng ký</button>
        </form>
        <p class="auth-switch">Đã có tài khoản? <a asp-controller="Account" asp-action="Login" asp-route-returnUrl="@Model.ReturnUrl">Đăng nhập</a></p>
        <a class="rentcar-accent d-inline-block mt-3" asp-controller="Home" asp-action="Index">← Quay về trang chủ</a>
    </main>
    <script src="~/js/register.js" asp-append-version="true"></script>
</body>
</html>
