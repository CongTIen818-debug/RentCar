@model IReadOnlyList<RentCar.Models.Database.RentalContract>
@{
    Layout = "_ManagementLayout";
    ViewData["Title"] = "Hợp đồng thuê";
}
<a asp-action="Edit" class="btn management-primary mb-3">Thêm mới</a>
<div class="table-responsive">
    <table class="table align-middle">
        <thead><tr><th scope="col">ID yêu cầu thuê</th><th scope="col">Mã hợp đồng</th><th scope="col">Giá thuê</th><th scope="col">Trạng thái</th><th scope="col">Thao tác</th></tr></thead>
        <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.RentalRequestId</td>
                <td>@item.ContractCode</td>
                <td>@item.RentalPrice</td>
                <td>@item.Status</td>
                <td>
                    @if (item.Status == "Chờ xác nhận")
                    {
                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary">Sửa</a>
                    <form asp-action="Delete" asp-route-id="@item.Id" method="post" class="d-inline" onsubmit="return confirm('Xác nhận thao tác?');">
                        <button type="submit" class="btn btn-sm btn-outline-danger">Hủy</button>
                    </form>
                    }
                </td>
            </tr>
        }
        </tbody>
    </table>
</div>
