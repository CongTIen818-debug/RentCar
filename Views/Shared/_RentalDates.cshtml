@model RentCar.Models.RentalDates
        <div class="rental-dates">
            <div>
                <label for="pickupDate">Ngày giờ nhận</label>
                <div class="rental-date-picker" data-date-picker>
                    <div class="rental-date-entry">
                        <input id="pickupDate" type="text" inputmode="numeric" placeholder="dd/mm/yyyy"
                               aria-label="Ngày nhận" autocomplete="off" maxlength="10"
                               value="@Model?.PickupAt?.ToString("dd/MM/yyyy")" />
                        <button type="button" class="calendar-toggle" aria-label="Chọn ngày nhận"
                                aria-expanded="false" aria-controls="pickupCalendar">Lịch</button>
                    </div>
                    <div id="pickupCalendar" class="rental-calendar" role="group" aria-label="Lịch ngày nhận" hidden></div>
                    <label class="rental-time-label" for="pickupTime">Giờ nhận (24 giờ)</label>
                    <input id="pickupTime" type="text" inputmode="numeric" placeholder="HH:mm"
                           aria-label="Giờ nhận theo định dạng 24 giờ" maxlength="5" autocomplete="off"
                           value="@(Model?.PickupAt?.ToString("HH:mm") ?? "09:00")" />
                    <input id="pickupAt" name="pickupAt" type="hidden"
                           value="@Model?.PickupAt?.ToString("yyyy-MM-ddTHH:mm")" />
                </div>
            </div>
            <div>
                <label for="returnDate">Ngày giờ trả</label>
                <div class="rental-date-picker" data-date-picker>
                    <div class="rental-date-entry">
                        <input id="returnDate" type="text" inputmode="numeric" placeholder="dd/mm/yyyy"
                               aria-label="Ngày trả" autocomplete="off" maxlength="10"
                               value="@Model?.ReturnAt?.ToString("dd/MM/yyyy")" />
                        <button type="button" class="calendar-toggle" aria-label="Chọn ngày trả"
                                aria-expanded="false" aria-controls="returnCalendar">Lịch</button>
                    </div>
                    <div id="returnCalendar" class="rental-calendar" role="group" aria-label="Lịch ngày trả" hidden></div>
                    <label class="rental-time-label" for="returnTime">Giờ trả (24 giờ)</label>
                    <input id="returnTime" type="text" inputmode="numeric" placeholder="HH:mm"
                           aria-label="Giờ trả theo định dạng 24 giờ" maxlength="5" autocomplete="off"
                           value="@(Model?.ReturnAt?.ToString("HH:mm") ?? "09:00")" />
                    <input id="returnAt" name="returnAt" type="hidden"
                           value="@Model?.ReturnAt?.ToString("yyyy-MM-ddTHH:mm")" />
                </div>
            </div>
        </div>

