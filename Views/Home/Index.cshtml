@using System.Globalization
@model VehicleFilterViewModel
@{
    ViewData["Title"] = "Trang chủ";
}

<section class="rental-hero">
    <div class="rental-intro">
        <p>RENTCAR · THUÊ XE TỰ LÁI</p>
        <h1>Tìm xe cho chuyến đi của bạn</h1>
        <p>Khám phá xe sang cho chuyến đi của bạn.</p>
    </div>
    <form id="rental-search" class="rental-search" method="get" asp-controller="Home" asp-action="Index">
        <div class="rental-dates">
            <div>
                <label for="pickupDate">Ngày giờ nhận</label>
                <div class="rental-date-picker" data-date-picker>
                    <div class="rental-date-entry">
                        <input id="pickupDate" type="text" inputmode="numeric" placeholder="dd/mm/yyyy"
                               aria-label="Ngày nhận" autocomplete="off" maxlength="10"
                               value="@Model?.PickupAt?.ToString("dd/MM/yyyy")" />
                        <button type="button" class="calendar-toggle" aria-label="Chọn ngày nhận"
                                aria-expanded="false" aria-controls="pickupCalendar">Lịch</button>
                    </div>
                    <div id="pickupCalendar" class="rental-calendar" role="group" aria-label="Lịch ngày nhận" hidden></div>
                    <label class="rental-time-label" for="pickupTime">Giờ nhận (24 giờ)</label>
                    <input id="pickupTime" type="text" inputmode="numeric" placeholder="HH:mm"
                           aria-label="Giờ nhận theo định dạng 24 giờ" maxlength="5" autocomplete="off"
                           value="@(Model?.PickupAt?.ToString("HH:mm") ?? "09:00")" />
                    <input id="pickupAt" name="pickupAt" type="hidden"
                           value="@Model?.PickupAt?.ToString("yyyy-MM-ddTHH:mm")" />
                </div>
            </div>
            <div>
                <label for="returnDate">Ngày giờ trả</label>
                <div class="rental-date-picker" data-date-picker>
                    <div class="rental-date-entry">
                        <input id="returnDate" type="text" inputmode="numeric" placeholder="dd/mm/yyyy"
                               aria-label="Ngày trả" autocomplete="off" maxlength="10"
                               value="@Model?.ReturnAt?.ToString("dd/MM/yyyy")" />
                        <button type="button" class="calendar-toggle" aria-label="Chọn ngày trả"
                                aria-expanded="false" aria-controls="returnCalendar">Lịch</button>
                    </div>
                    <div id="returnCalendar" class="rental-calendar" role="group" aria-label="Lịch ngày trả" hidden></div>
                    <label class="rental-time-label" for="returnTime">Giờ trả (24 giờ)</label>
                    <input id="returnTime" type="text" inputmode="numeric" placeholder="HH:mm"
                           aria-label="Giờ trả theo định dạng 24 giờ" maxlength="5" autocomplete="off"
                           value="@(Model?.ReturnAt?.ToString("HH:mm") ?? "09:00")" />
                    <input id="returnAt" name="returnAt" type="hidden"
                           value="@Model?.ReturnAt?.ToString("yyyy-MM-ddTHH:mm")" />
                </div>
            </div>
        </div>
        @if (Model is null) { <p role="alert">Chưa tải được dữ liệu xe. Vui lòng thử lại sau.</p> }
        @if (Model?.SearchError is string error)
        {
            <p role="alert">@error</p>
        }
        <button type="submit" disabled="@(Model is null)">Tìm xe</button>
    </form>
</section>

@if (Model is { SearchError: null })
{
    <section class="rental-results" aria-label="Kết quả tìm xe">
        <h2>@(Model.IsSearch ? "Kết quả tìm xe" : "Danh sách xe")</h2>
        <p>@Model.ResultCount xe phù hợp@(Model.IsSearch ? " theo lịch thuê của toàn đội xe." : ".")</p>
        @if (Model.ResultCount > Model.Results.Count)
        {
            <p>Hiển thị @Model.Results.Count xe có giá thấp nhất.</p>
        }
        <div class="rental-car-grid">
            @foreach (var car in Model.Results)
            {
                <article class="rental-car">
                    @if (!string.IsNullOrWhiteSpace(car.ImageUrl))
                    {
                        <img class="rental-car-image" src="@car.ImageUrl" alt="@car.Name" loading="lazy" />
                    }
                    else
                    {
                        <div class="rental-car-image rental-car-placeholder">Chưa có ảnh xe</div>
                    }
                    <div class="rental-car-details">
                        <span class="rental-car-type">@car.VehicleType</span>
                        <h3>@car.Name</h3>
                        <p>@car.Edition · @car.Color</p>
                        @if (car.DailyRate < car.OriginalRate)
                        {
                            <div><del class="text-muted">@car.OriginalRate.ToString("N0", CultureInfo.GetCultureInfo("vi-VN")) ₫/ngày</del></div>
                        }
                        <strong>@car.DailyRate.ToString("N0", CultureInfo.GetCultureInfo("vi-VN")) ₫/ngày</strong>
                    </div>
                </article>
            }
        </div>
    </section>
}

@section Sidebar {
    <div class="vehicle-filters">
        <h2>Lọc xe</h2>
        @if (Model is null)
        {
            <p role="status">Chưa tải được bộ lọc từ cơ sở dữ liệu.</p>
        }
        else
        {
            <div>
                <fieldset>
                    <legend>Loại xe</legend>
                    @foreach (var option in Model.Types)
                    {
                        <label class="vehicle-filter-option">
                            <input form="rental-search" type="checkbox" name="types" value="@option.Value" checked="@Model.SelectedTypes.Contains(option.Value)" />
                            <span>@option.Value</span><small>@option.Count</small>
                        </label>
                    }
                </fieldset>

                <fieldset>
                    <legend>Giá thuê tối đa mỗi ngày</legend>
                    <input form="rental-search" id="max-price" aria-label="Giá thuê tối đa mỗi ngày" type="range" name="maxPrice"
                           min="0" max="@Model.HighestPrice.ToString(CultureInfo.InvariantCulture)" step="0.01"
                           value="@Model.SelectedPrice.ToString(CultureInfo.InvariantCulture)" />
                    <output id="price-label" for="max-price">@Model.SelectedPrice.ToString("N0", CultureInfo.GetCultureInfo("vi-VN")) ₫</output>
                </fieldset>
                <button form="rental-search" type="submit" formnovalidate>Áp dụng</button>
                <a asp-controller="Home" asp-action="Index">Xóa lọc</a>
                <p class="vehicle-filter-count" role="status">@Model.ResultCount xe phù hợp</p>
            </div>
        }
    </div>
}

@section Scripts {
    <script>
        const priceSlider = document.getElementById('max-price');
        if (priceSlider) {
            const priceLabel = document.getElementById('price-label');
            const formatPrice = new Intl.NumberFormat('vi-VN', { style: 'currency', currency: 'VND' });
            priceSlider.addEventListener('input', () => {
                priceLabel.value = formatPrice.format(priceSlider.valueAsNumber);
            });
        }
    </script>
}
