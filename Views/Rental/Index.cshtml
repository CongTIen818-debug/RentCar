@using System.Globalization
@model RentalReviewViewModel
@{
    ViewData["Title"] = "Danh sách xe thuê";
    var currency = CultureInfo.GetCultureInfo("vi-VN");
}
<div class="detail-heading"><p class="detail-category">RENTCAR · HÀNH TRÌNH CỦA BẠN</p><h1>Danh sách xe thuê</h1></div>
@if (Model.Lines.Count == 0)
{
    <div class="rental-empty"><h2>Danh sách đang trống</h2><p>Chọn từng xe phù hợp rồi thêm vào danh sách để tính chi phí chung.</p>
        <a class="btn management-primary" href="/dich-vu/thue-xe-tu-lai">Xem danh sách xe</a>
    </div>
}
else
{
    <div class="vehicle-detail-grid rental-review">
        <div>
            <div class="rental-selection">
                @foreach (var line in Model.Lines)
                {
                    var car = line.Car;
                    <article class="selection-row">
                        @if (!string.IsNullOrWhiteSpace(car.ImageUrl)) { <img src="@car.ImageUrl" alt="@car.Name" /> }
                        <div class="selection-description">
                            <h2 class="h5"><a class="car-title-link" asp-controller="Cars" asp-action="Details" asp-route-id="@car.Id" asp-route-withDriver="@line.WithDriver">@car.Name</a></h2>
                            <p>@car.VehicleType</p>
                            <strong>@car.DailyRate.ToString("N0", currency) ₫/ngày</strong>
                            @if (!car.IsReady) { <p class="text-danger">Xe hiện không sẵn sàng.</p> }
                            @if (Model.SingleId is null)
                            {
                                <form asp-action="UpdateDriver" method="post" class="selection-driver-form">
                                    <input type="hidden" name="id" value="@car.Id" />
                                    <input type="hidden" name="pickupAt" value="@Model.PickupAt?.ToString("s")" />
                                    <input type="hidden" name="returnAt" value="@Model.ReturnAt?.ToString("s")" />
                                    <label class="driver-option">
                                        <input type="checkbox" name="withDriver" value="true" checked="@line.WithDriver" disabled="@(!line.CanHaveDriver)" />
                                        <span>Kèm tài xế <small>+1.000.000 ₫/ngày</small></span>
                                    </label>
                                    @if (line.CanHaveDriver) { <button type="submit" class="btn btn-sm btn-outline-secondary">Cập nhật</button> }
                                </form>
                            }
                            else if (line.WithDriver) { <p class="mt-2">Kèm tài xế: +1.000.000 ₫/ngày</p> }
                        </div>
                        @if (Model.SingleId is null)
                        {
                            <form asp-action="Remove" method="post">
                                <input type="hidden" name="id" value="@car.Id" />
                                <input type="hidden" name="pickupAt" value="@Model.PickupAt?.ToString("s")" />
                                <input type="hidden" name="returnAt" value="@Model.ReturnAt?.ToString("s")" />
                                <button type="submit" class="btn btn-outline-secondary">Bỏ xe</button>
                            </form>
                        }
                    </article>
                }
            </div>
            <div class="selection-actions"><a href="/dich-vu/thue-xe-tu-lai">← Chọn thêm xe</a><p>6–9 xe giảm 6% · Từ 10 xe giảm 10% tiền xe</p></div>
        </div>
        <aside class="vehicle-booking rental-cost-panel">
            <h2 class="h5">Thời gian &amp; chi phí thuê</h2>
            <form id="rental-search" method="get" asp-action="@(Model.SingleId is null ? "Index" : "Review")" class="rental-search review-search">
                @if (Model.SingleId is not null)
                {
                    <input type="hidden" name="id" value="@Model.SingleId" />
                    <input type="hidden" name="withDriver" value="@Model.Lines[0].WithDriver.ToString().ToLowerInvariant()" />
                }
                <partial name="_RentalDates" model="@(new RentalDates(Model.PickupAt, Model.ReturnAt))" />
                <button type="submit">Kiểm tra lịch &amp; tính tiền</button>
            </form>
            @if (Model.Error is not null) { <p class="text-danger mt-3" role="alert">@Model.Error</p> }
            <div class="rental-cost-summary" aria-live="polite">
                <p>@Model.Lines.Count xe · @(Model.Days > 0 ? Model.Days + " ngày thuê" : "Ước tính 1 ngày thuê")</p>
                @if (Model.Days == 0) { <p class="small text-muted">Chọn ngày nhận và trả để kiểm tra lịch trống và tính tổng cho chuyến đi.</p> }
                <dl>
                    <div><dt>Tổng tiền xe</dt><dd>@Model.Price.VehicleTotal.ToString("N0", currency) ₫</dd></div>
                    @if (Model.Price.DiscountRate > 0)
                    {
                        <div class="cost-discount"><dt>Khấu trừ khi thuê từ @(Model.Lines.Count >= 10 ? 10 : 6) xe (@((Model.Price.DiscountRate * 100).ToString("0"))%)</dt><dd>−@Model.Price.Discount.ToString("N0", currency) ₫</dd></div>
                    }
<<<<<<< Updated upstream
