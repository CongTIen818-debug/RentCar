                    <input type="hidden" name="id" value="@car.Id" />
                    <button type="submit" class="btn btn-outline-secondary">Bỏ xe</button>
                </form>
            </article>
        }
    </div>
    <div class="selection-actions">
        <a asp-controller="Home" asp-action="Index">Chọn thêm xe</a>
        <a class="btn management-primary" asp-action="Checkout">Đặt thuê danh sách (@Model.Count xe)</a>
