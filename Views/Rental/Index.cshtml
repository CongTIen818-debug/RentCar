                    <div><dt>VAT @((Model.Price.VatRate * 100).ToString("0"))%</dt><dd>@Model.Price.Vat.ToString("N0", currency) ₫</dd></div>
                    <div class="cost-payable"><dt>Khoản tiền phải thanh toán</dt><dd>@Model.Price.Payable.ToString("N0", currency) ₫</dd></div>
