@using System.Globalization
@model VehicleDetailsViewModel
@{
    ViewData["Title"] = Model.Car.Name;
    var currency = CultureInfo.GetCultureInfo("vi-VN");
}
<nav class="detail-breadcrumb" aria-label="Đường dẫn">
    <a asp-controller="Home" asp-action="Index">Trang chủ</a> / <span>@Model.Car.Name</span>
</nav>
<div class="detail-heading">
    <p class="detail-category">@Model.Car.VehicleType</p>
    <h1>@Model.Car.Name <span>@Model.Car.Edition</span></h1>
    <p>@Model.Car.Year · @Model.Car.Color</p>
</div>
<div class="vehicle-detail-grid">
    <div>
        <div class="vehicle-gallery">
            @if (Model.Images.Count > 0)
            {
                <img id="vehicle-main-image" src="@Model.Images[0]" alt="@Model.Car.Name @Model.Car.Color" />
            }
            else
            {
                <div class="vehicle-gallery-empty">Chưa có ảnh xe</div>
            }
        </div>
        @if (Model.Images.Count > 1)
        {
            <div class="vehicle-thumbnails" aria-label="Ảnh xe">
                @for (var index = 0; index < Model.Images.Count; index++)
                {
                    <button type="button" data-gallery-image="@Model.Images[index]" aria-label="Xem ảnh @(index + 1)"
                            aria-pressed="@(index == 0 ? "true" : "false")">
                        <img src="@Model.Images[index]" alt="" loading="lazy" />
                    </button>
                }
            </div>
        }
        <section class="vehicle-description">
            <h2>Giới thiệu @Model.Car.Name</h2>
            @if (Model.Profile is not null)
            {
                <p>@Model.Profile.Description</p>
            }
            else
            {
                <p>@Model.Car.Name @Model.Car.Edition, màu @Model.Car.Color, năm @Model.Car.Year.</p>
            }
            <h2>Thông tin xe</h2>
            <dl class="vehicle-specs">
                <div><dt>Hãng xe</dt><dd>@Model.Car.Brand</dd></div>
                <div><dt>Phiên bản</dt><dd>@Model.Car.Edition</dd></div>
                <div><dt>Năm sản xuất</dt><dd>@Model.Car.Year</dd></div>
                <div><dt>Màu sắc</dt><dd>@Model.Car.Color</dd></div>
                <div><dt>Loại xe</dt><dd>@Model.Car.VehicleType</dd></div>
            </dl>
            @if (Model.Profile is not null)
            {
                <h2>Thông số tham khảo</h2>
                <dl class="vehicle-specs">
                    @foreach (var spec in Model.Profile.Specifications)
                    {
                        <div><dt>@spec.Key</dt><dd>@spec.Value</dd></div>
                    }
                </dl>
                <p class="detail-source">Thông số theo dòng xe, trang bị có thể khác theo thị trường và phiên bản.
                    <a href="@Model.Profile.SourceUrl" target="_blank" rel="noopener noreferrer">Nguồn @Model.Profile.SourceName ↗</a>
                </p>
            }
            <h2>Thuê xe tại RentCar</h2>
            <details class="rental-faq">
                <summary>Tôi có được nhận đúng chiếc xe này không?</summary>
                <p>Mỗi thẻ RentCar là một chiếc xe cụ thể. Lịch thuê được kiểm tra cho đúng chiếc xe bạn chọn.</p>
            </details>
            <details class="rental-faq">
                <summary>Tôi muốn thuê nhiều xe thì làm thế nào?</summary>
                <p>Thêm từng xe vào danh sách thuê, sau đó chọn thời gian nhận và trả cho cả danh sách.</p>
            </details>
            <details class="rental-faq">
                <summary>Giá ưu đãi được áp dụng khi nào?</summary>
                <p>Giá được tính theo chương trình còn hiệu lực tại thời điểm đặt. Bạn sẽ xem lại giá thuê trước khi thanh toán.</p>
            </details>
        </section>
    </div>
    <aside class="vehicle-booking" aria-label="Đặt thuê xe">
        <p class="booking-label">Giá thuê mỗi ngày</p>
        @if (Model.Car.DailyRate < Model.Car.OriginalRate)
        {
            <del>@Model.Car.OriginalRate.ToString("N0", currency) ₫</del>
        }
        <p class="booking-price">@Model.Car.DailyRate.ToString("N0", currency) <span>₫ / ngày</span></p>
        <p class="booking-availability">@(Model.Car.IsReady ? "Sẵn sàng tiếp nhận đặt thuê" : "Hiện không sẵn sàng")</p>
        @if (Model.Car.IsReady)
        {
            <a class="btn management-primary w-100" asp-controller="Rental" asp-action="Review"
               asp-route-id="@Model.Car.Id" asp-route-pickupAt="@Model.PickupAt?.ToString("s")"
               asp-route-returnAt="@Model.ReturnAt?.ToString("s")">Đặt thuê</a>
            <form asp-controller="Rental" asp-action="Add" method="post" class="mt-2">
                <input type="hidden" name="id" value="@Model.Car.Id" />
                <input type="hidden" name="pickupAt" value="@Model.PickupAt?.ToString("s")" />
                <input type="hidden" name="returnAt" value="@Model.ReturnAt?.ToString("s")" />
                <button type="submit" class="btn booking-secondary w-100">Thêm vào danh sách thuê</button>
            </form>
        }
        <a class="booking-list-link" asp-controller="Rental" asp-action="Index">Xem danh sách thuê →</a>
    </aside>
</div>
@section Scripts {
    <script src="~/js/vehicle-details.js" asp-append-version="true"></script>
}

