@model VehicleForm
@{
    Layout = "_ManagementLayout";
    ViewData["Title"] = ViewContext.RouteData.Values["id"] is null ? "Thêm mới" : "Chỉnh sửa";
}
<form method="post" asp-action="Edit" asp-route-id="@ViewContext.RouteData.Values["id"]" class="row g-3">
    <div asp-validation-summary="All" class="text-danger"></div>
    <div class="col-md-6">
        <label asp-for="PlateNumber" class="form-label"></label>
        <input asp-for="PlateNumber" class="form-control" />
    </div>
    <div class="col-md-6">
        <label asp-for="Brand" class="form-label"></label>
        <select asp-for="Brand" class="form-select"
                asp-items="@(new Microsoft.AspNetCore.Mvc.Rendering.SelectList(ViewBag.Brands))">
            <option value="">Chọn hãng xe</option>
        </select>
    </div>
    <div class="col-md-6">
        <label asp-for="Model" class="form-label"></label>
        <input asp-for="Model" class="form-control" />
    </div>
    <div class="col-md-6">
        <label asp-for="VehicleType" class="form-label"></label>
        <input asp-for="VehicleType" class="form-control" />
    </div>
    <div class="col-md-6">
        <label asp-for="Seats" class="form-label"></label>
        <input asp-for="Seats" class="form-control" />
    </div>
    <div class="col-md-6">
        <label asp-for="Transmission" class="form-label"></label>
        <input asp-for="Transmission" class="form-control" />
    </div>
    <div class="col-md-6">
        <label asp-for="FuelType" class="form-label"></label>
        <input asp-for="FuelType" class="form-control" />
    </div>
    <div class="col-md-6">
        <label asp-for="ManufactureYear" class="form-label"></label>
        <input asp-for="ManufactureYear" class="form-control" />
    </div>
    <div class="col-md-6">
        <label asp-for="DailyRate" class="form-label"></label>
        <input asp-for="DailyRate" class="form-control" type="number" step="0.01" min="0" />
    </div>
    <div class="col-md-6">
        <label asp-for="WeeklyRate" class="form-label"></label>
        <input asp-for="WeeklyRate" class="form-control" type="number" step="0.01" min="0" />
    </div>
    <div class="col-md-6">
        <label asp-for="DepositAmount" class="form-label"></label>
        <input asp-for="DepositAmount" class="form-control" type="number" step="0.01" min="0" />
    </div>
    <div>
        <button class="btn management-primary" type="submit">Lưu</button>
        <a asp-action="Index" class="btn btn-outline-secondary">Quay lại</a>
    </div>
</form>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
