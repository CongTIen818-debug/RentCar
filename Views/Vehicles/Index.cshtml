@model IReadOnlyList<RentCar.Models.Database.Vehicle>
@{
    Layout = "_ManagementLayout";
    ViewData["Title"] = "Đội xe";
}
<a asp-action="Edit" class="btn management-primary mb-3">Thêm mới</a>
<div class="table-responsive">
    <table class="table align-middle">
        <thead><tr><th scope="col">Biển số</th><th scope="col">Hãng</th><th scope="col">Dòng xe</th><th scope="col">Giá ngày</th><th scope="col">Trạng thái</th><th scope="col">Thao tác</th></tr></thead>
        <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.PlateNumber</td>
                <td>@item.Brand</td>
                <td>@item.Model</td>
                <td>@item.DailyRate.ToString("N0") ₫</td>
                <td>@item.Status</td>
                <td>
                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary">Sửa</a>
                    @if (item.Status != "Ngừng hoạt động")
                    {
                        <form asp-action="Delete" asp-route-id="@item.Id" method="post" class="d-inline"
                              onsubmit="return confirm('Xác nhận ngừng hoạt động mục này?');">
                            <button type="submit" class="btn btn-sm btn-outline-danger">Xóa</button>
                        </form>
                    }
                </td>
            </tr>
        }
        </tbody>
    </table>
</div>
@if (Model.Count == 0)
{
    <p class="text-muted">Chưa có dữ liệu.</p>
}
