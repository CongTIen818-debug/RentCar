@model RentCar.Web.Models.ResetPasswordForm
@{
    ViewData["Title"] = "Đặt lại mật khẩu";
    var devCode = ViewBag.DevCode as string;
}
<section class="section-head">
    <div><span class="eyebrow">TÀI KHOẢN</span><h1 class="h-icon">@await Html.PartialAsync("_Icon", "lock:md")<span>Đặt lại mật khẩu</span></h1><p class="muted">Nhập email, mã đặt lại và mật khẩu mới. Mã dùng một lần và hết hạn sau 30 phút.</p></div>
</section>
@if (!string.IsNullOrEmpty(devCode))
{
    <div class="flash">Chế độ phát triển (mô phỏng gửi email): mã đặt lại là <strong>@devCode</strong></div>
}
<form asp-action="ResetPassword" method="post" class="form-card" novalidate>
    @Html.AntiForgeryToken()
    @Html.ValidationSummary(true, "", new { @class = "flash flash--bad" })
    <label class="field"><span class="field__label">Email</span>
        <input class="field__input" asp-for="Email" autocomplete="username" />
        <span class="field__error" asp-validation-for="Email"></span></label>
    <label class="field"><span class="field__label">Mã đặt lại</span>
        <input class="field__input" asp-for="Code" autocomplete="one-time-code" placeholder="XXXX-XXXX-XXXX" />
        <span class="field__error" asp-validation-for="Code"></span></label>
    <label class="field"><span class="field__label">Mật khẩu mới</span>
        <input class="field__input" asp-for="NewPassword" autocomplete="new-password" />
        <span class="field__error" asp-validation-for="NewPassword"></span></label>
    <label class="field"><span class="field__label">Nhập lại mật khẩu mới</span>
        <input class="field__input" asp-for="ConfirmPassword" autocomplete="new-password" />
        <span class="field__error" asp-validation-for="ConfirmPassword"></span></label>
    <button class="btn btn--ink" type="submit">Đặt lại mật khẩu</button>
</form>
