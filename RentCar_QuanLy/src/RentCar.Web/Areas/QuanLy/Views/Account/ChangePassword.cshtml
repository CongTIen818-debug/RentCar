@model RentCar.Web.Models.ChangePasswordForm
@{
    ViewData["Title"] = "Đổi mật khẩu";
}
<section class="section-head">
    <div><span class="eyebrow">TÀI KHOẢN</span><h1 class="h-icon">@await Html.PartialAsync("_Icon", "lock:md")<span>Đổi mật khẩu</span></h1><p class="muted">Cần nhập đúng mật khẩu hiện tại. Mật khẩu mới tối thiểu 8 ký tự, gồm chữ hoa, chữ thường và chữ số.</p></div>
</section>
<form asp-action="ChangePassword" method="post" class="form-card" novalidate>
    @Html.AntiForgeryToken()
    @Html.ValidationSummary(true, "", new { @class = "flash flash--bad" })
    <label class="field"><span class="field__label">Mật khẩu hiện tại</span>
        <input class="field__input" asp-for="CurrentPassword" autocomplete="current-password" />
        <span class="field__error" asp-validation-for="CurrentPassword"></span></label>
    <label class="field"><span class="field__label">Mật khẩu mới</span>
        <input class="field__input" asp-for="NewPassword" autocomplete="new-password" />
        <span class="field__error" asp-validation-for="NewPassword"></span></label>
    <label class="field"><span class="field__label">Nhập lại mật khẩu mới</span>
        <input class="field__input" asp-for="ConfirmPassword" autocomplete="new-password" />
        <span class="field__error" asp-validation-for="ConfirmPassword"></span></label>
    <button class="btn btn--ink" type="submit">Lưu mật khẩu mới</button>
</form>
