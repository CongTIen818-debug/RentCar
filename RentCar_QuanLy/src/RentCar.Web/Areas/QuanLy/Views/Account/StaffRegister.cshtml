@model RentCar.Web.Models.StaffRegisterForm
@{
    ViewData["Title"] = "Nhân viên đăng ký bằng mã";
}

<section class="auth">
    <aside class="auth__aside">
        <p class="eyebrow">Dành cho nhân viên</p>
        <h1>Tạo tài khoản bằng mã công ty cấp.</h1>
        <p>Mã do quản trị viên cấp cho đúng email của bạn. Mã có hạn 7 ngày và chỉ dùng được một lần. Sau khi đăng ký, bạn đăng nhập ngay và có đúng quyền của vai trò ghi trong mã.</p>
        <ul class="auth__roles">
            <li>Nhân viên kinh doanh</li>
            <li>Nhân viên giao nhận</li>
            <li>Kế toán</li>
            <li>Quản trị viên</li>
        </ul>
    </aside>

    <div class="auth__card">
        <h2>Đăng ký nhân viên</h2>
        @Html.ValidationSummary(true, "", new { @class = "flash flash--bad" })
        <form asp-controller="Account" asp-action="StaffRegister" method="post" novalidate>
            @Html.AntiForgeryToken()
            <label class="field">
                <span class="field__label">Mã đăng ký</span>
                <input class="field__input" asp-for="Code" autocomplete="one-time-code" placeholder="XXXX-XXXX-XXXX" />
                <span class="field__error" asp-validation-for="Code"></span>
            </label>
            <label class="field">
                <span class="field__label">Email (đúng email được cấp mã)</span>
                <input class="field__input" asp-for="Email" autocomplete="username" placeholder="ten@congty.vn" />
                <span class="field__error" asp-validation-for="Email"></span>
            </label>
            <label class="field">
                <span class="field__label">Số điện thoại (không bắt buộc)</span>
                <input class="field__input" asp-for="Phone" autocomplete="tel" placeholder="09xxxxxxxx" />
                <span class="field__error" asp-validation-for="Phone"></span>
            </label>
            <label class="field">
                <span class="field__label">Mật khẩu</span>
                <input class="field__input" asp-for="Password" autocomplete="new-password" />
                <span class="field__error" asp-validation-for="Password"></span>
                <small class="field__hint">Tối thiểu 8 ký tự, gồm chữ hoa, chữ thường và chữ số.</small>
            </label>
            <label class="field">
                <span class="field__label">Nhập lại mật khẩu</span>
                <input class="field__input" asp-for="ConfirmPassword" autocomplete="new-password" />
                <span class="field__error" asp-validation-for="ConfirmPassword"></span>
            </label>
            <button class="btn btn--ink btn--block" type="submit">Tạo tài khoản</button>
        </form>
        <p class="auth__alt">Chưa có mã? Hãy liên hệ quản trị viên để được cấp mã.</p>
        <p class="auth__alt">Đã có tài khoản? <a asp-controller="Account" asp-action="Login">Đăng nhập</a></p>
    </div>
</section>
