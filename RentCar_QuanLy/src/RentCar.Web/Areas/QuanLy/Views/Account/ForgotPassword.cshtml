@model RentCar.Web.Models.ForgotPasswordForm
@{
    ViewData["Title"] = "Quên mật khẩu";
}
<section class="section-head">
    <div><span class="eyebrow">TÀI KHOẢN</span><h1 class="h-icon">@await Html.PartialAsync("_Icon", "mail:md")<span>Quên mật khẩu</span></h1><p class="muted">Nhập email đã đăng ký. Mã đặt lại có hiệu lực trong 30 phút và chỉ dùng được một lần.</p></div>
</section>
<form asp-action="ForgotPassword" method="post" class="form-card" novalidate>
    @Html.AntiForgeryToken()
    @Html.ValidationSummary(true, "", new { @class = "flash flash--bad" })
    <label class="field"><span class="field__label">Email</span>
        <input class="field__input" asp-for="Email" autocomplete="username" placeholder="ten@email.com" />
        <span class="field__error" asp-validation-for="Email"></span></label>
    <button class="btn btn--ink" type="submit">Gửi mã đặt lại</button>
</form>
<p class="auth__alt"><a asp-action="ResetPassword">Đã có mã? Nhập mã đặt lại</a></p>
