@model LoginForm
@{
    ViewData["Title"] = "Đăng nhập";
}

<section class="auth">
    <aside class="auth__aside">
        <p class="eyebrow">Chào mừng trở lại</p>
        <h1>Theo dõi chuyến đi và hợp đồng ở một nơi.</h1>
        <p>Khách hàng xem yêu cầu và hợp đồng của mình. Nhân viên xử lý theo đúng quyền hạn của vai trò.</p>
        <ul class="auth__roles">
            <li>Khách hàng</li>
            <li>Nhân viên kinh doanh</li>
            <li>Kế toán</li>
            <li>Quản trị viên</li>
        </ul>
    </aside>

    <div class="auth__card">
        <h2>Đăng nhập</h2>
        @Html.ValidationSummary(true, "", new { @class = "flash flash--bad" })
        <form method="post" asp-controller="Account" asp-action="Login" novalidate>
            <input type="hidden" asp-for="ReturnUrl" />
            <label class="field">
                <span class="field__label">Email</span>
                <input class="field__input" asp-for="Email" autocomplete="username" placeholder="ten@email.com" />
                <span class="field__error" asp-validation-for="Email"></span>
            </label>
            <label class="field">
                <span class="field__label">Mật khẩu</span>
                <input class="field__input" asp-for="Password" autocomplete="current-password" />
                <span class="field__error" asp-validation-for="Password"></span>
            </label>
            <button class="btn btn--ink btn--block" type="submit">Đăng nhập</button>
        </form>
        <p class="auth__alt"><a asp-controller="Account" asp-action="ForgotPassword">Quên mật khẩu?</a></p>
        <p class="auth__alt">Chưa có tài khoản? <a asp-controller="Account" asp-action="Register">Đăng ký khách hàng</a></p>
        <p class="auth__alt">Là nhân viên được cấp mã? <a asp-controller="Account" asp-action="StaffRegister">Đăng ký bằng mã</a></p>
    </div>
</section>
